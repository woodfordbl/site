        "decimals": 4
      },
      {
        "id": "lng",
        "name": "Longitude",
        "type": "number",
        "icon": "tabler:IconWorldLongitude",
        "format": "plain",
        "decimals": 4
      },
      {
        "id": "country",
        "name": "Country",
        "type": "text",
        "icon": "tabler:IconFlag"
      },
      {
        "id": "firstLaunch",
        "name": "First launch",
        "type": "date",
        "icon": "tabler:IconCalendar"
      }
    ],
    "views": [
      {
        "id": "table",
        "name": "Table",
        "type": "table",
        "config": {
          "columnWidths": { "site": 260 },
          "calculations": { "site": "countAll" }
        }
      },
      {
        "id": "map",
        "name": "Map",
        "type": "map",
        "icon": "tabler:IconMapPin",
        "config": {
          "map": {
            "mark": "pins",
            "pointMode": "pair",
            "latFieldId": "lat",
            "lngFieldId": "lng",
            "colorFieldId": "operator"
          }
        }
      },
      {
        "id": "by-country",
        "name": "By country",
        "type": "map",
        "icon": "tabler:IconWorld",
        "config": {
          "map": {
            "mark": "region",
            "joinFieldId": "country",
            "joinProperty": "ADM0_A3",
            "valueAggregate": "count"
          }
        }
      }
    ]
  },
